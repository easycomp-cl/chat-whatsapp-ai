generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  PAUSED
}

enum ChannelType {
  WHATSAPP_BUSINESS
}

enum ChannelStatus {
  ACTIVE
  INACTIVE
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum ConversationMode {
  BOT
  HUMAN
}

enum ConversationChannel {
  WHATSAPP
}

enum SenderType {
  CUSTOMER
  BOT
  HUMAN
  SYSTEM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsappDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum CustomerInvoiceType {
  RECEIPT
  INVOICE
  NONE
}

enum BillingSameAsDelivery {
  NONE
  DELIVERY_1
  DELIVERY_2
}

enum ContentType {
  TEXT
  IMAGE
  AUDIO
  DOCUMENT
  INTERACTIVE
}

enum KnowledgeSourceType {
  PDF
  DOCX
  TXT
  MANUAL
  URL
}

enum KnowledgeDocumentStatus {
  PENDING
  INDEXING
  INDEXED
  ERROR
}

enum CatalogProductSource {
  MANUAL
  CSV
  JSON
  SHOPIFY
}

enum IntegrationProvider {
  SHOPIFY
  FLOW_WEBHOOK
}

enum ChatImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ChatSenderRole {
  CUSTOMER
  BUSINESS
  UNKNOWN
}

enum FaqSuggestionStatus {
  PENDING_REVIEW
  APPROVED
  EDITED
  REJECTED
  ARCHIVED
}

enum ToneAnalysisStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum FlowDefinitionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum FlowVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FlowTriggerType {
  MANUAL
  AI_INTENT
  KEYWORD
  WEBHOOK
  API
}

enum FlowRunStatus {
  RUNNING
  PAUSED
  AWAITING_CUSTOMER
  AWAITING_AGENT_INPUT
  AWAITING_REVIEW
  COMPLETED
  CANCELLED
  FAILED
}

enum FlowReviewStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  EXPIRED
}

enum FlowTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum FlowWebhookDeliveryStatus {
  PENDING
  DELIVERING
  DELIVERED
  FAILED
  DEAD_LETTER
}

enum FlowStartedBy {
  MANUAL
  TRIGGER_KEYWORD
  TRIGGER_INTENT
  TRIGGER_WEBHOOK
  TRIGGER_API
  SYSTEM
}

enum FlowFileSource {
  WHATSAPP_INBOUND
  AGENT_UPLOAD
  FLOW_OUTPUT
}

model Tenant {
  id                  String           @id @default(cuid())
  name                String
  slug                String           @unique
  businessType        String           @default("general")
  status              TenantStatus     @default(ACTIVE)
  botGlobalEnabled    Boolean          @default(true)
  defaultAiModel      String           @default("gpt-4o-mini")
  confidenceThreshold Float            @default(0.70)
  timezone            String           @default("America/Santiago")
  metadataJson        Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  channels            TenantChannel[]
  admins              TenantAdmin[]
  config              TenantConfig?
  faqs                TenantFaq[]
  documents           TenantDocument[]
  knowledgeChunks     KnowledgeChunk[]
  catalogProducts     TenantCatalogProduct[]
  deliveryRegions     TenantDeliveryRegion[]
  integrations        TenantIntegration[]
  customers           Customer[]
  conversations       Conversation[]
  messages            Message[]
  messageReactions    MessageReaction[]
  usageEvents         UsageEvent[]
  auditLogs           AuditLog[]
  chatImportJobs      ChatImportJob[]
  importedChatMessages ImportedChatMessage[]
  detectedFaqSuggestions DetectedFaqSuggestion[]
  toneAnalysisResults ToneAnalysisResult[]
  flowDefinitions     FlowDefinition[]
  flowVersions        FlowVersion[]
  flowTriggers        FlowTrigger[]
  flowRuns            FlowRun[]
  flowRunEvents       FlowRunEvent[]
  flowReviews         FlowReview[]
  flowTasks           FlowTask[]
  flowFiles           FlowFile[]
  flowWebhookDeliveries FlowWebhookDelivery[]
}

model TenantChannel {
  id                    String        @id @default(cuid())
  tenantId              String
  channelType           ChannelType   @default(WHATSAPP_BUSINESS)
  phoneNumber           String
  phoneNumberId         String        @unique
  wabaId                String?
  accessTokenEncrypted  String?
  verifyToken           String?
  coexistenceEnabled    Boolean       @default(false)
  status                ChannelStatus @default(ACTIVE)
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channelType])
}

model TenantAdmin {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  phoneNumber     String
  role            String   @default("collaborator")
  notifyOnHandoff Boolean  @default(true)
  isPrimary       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[]
  createdFlowDefinitions FlowDefinition[] @relation("FlowDefinitionCreatedBy")
  updatedFlowDefinitions FlowDefinition[] @relation("FlowDefinitionUpdatedBy")
  createdFlowVersions    FlowVersion[]    @relation("FlowVersionCreatedBy")
  startedFlowRuns        FlowRun[]        @relation("FlowRunStartedByAdmin")
  resolvedFlowReviews    FlowReview[]     @relation("FlowReviewReviewer")

  @@unique([tenantId, phoneNumber])
}

model TenantConfig {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  botName           String
  botTone           String
  greetingMessage   String
  fallbackMessage   String
  handoffMessage    String
  outOfHoursMessage String
  configJson        Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantFaq {
  id                String   @id @default(cuid())
  tenantId          String
  question          String
  answer            String
  category          String?
  priority          Int      @default(0)
  alternatePhrases  Json     @default("[]")
  keywords          Json     @default("[]")
  searchText        String?
  questionEmbedding Unsupported("vector(1536)")?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model TenantDocument {
  id          String                  @id @default(cuid())
  tenantId    String
  title       String
  sourceType  KnowledgeSourceType     @default(MANUAL)
  fileUrl     String?
  storagePath String?
  mimeType    String?
  fileSize    Int?
  rawText     String?
  status      KnowledgeDocumentStatus @default(PENDING)
  indexError  String?
  indexedAt   DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks      KnowledgeChunk[]

  @@index([tenantId])
}

model KnowledgeChunk {
  id         String                      @id @default(cuid())
  tenantId   String
  documentId String
  chunkText  String
  embedding  Unsupported("vector(1536)")?
  metadata   Json                        @default("{}")
  createdAt  DateTime                    @default(now())
  tenant     Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document   TenantDocument              @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([documentId])
}

model Customer {
  id                    String                 @id @default(cuid())
  tenantId              String
  phoneNumber           String
  name                  String?
  displayAlias          String?
  email                 String?
  taxId                 String?
  invoiceType           CustomerInvoiceType?
  companyName           String?
  businessActivity      String?
  delivery1Line1        String?
  delivery1Line2        String?
  delivery1Commune      String?
  delivery1Region       String?
  delivery1Notes        String?
  delivery2Line1        String?
  delivery2Line2        String?
  delivery2Commune      String?
  delivery2Region       String?
  delivery2Notes        String?
  billingLine1          String?
  billingLine2          String?
  billingCommune        String?
  billingRegion         String?
  billingNotes          String?
  billingSameAsDelivery BillingSameAsDelivery?
  profileMetadata       Json?
  profileUpdatedAt      DateTime?
  profileUpdatedBy      String?
  firstSeenAt           DateTime               @default(now())
  lastSeenAt            DateTime               @default(now())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations         Conversation[]
  messages              Message[]
  flowRuns              FlowRun[]
  flowFiles             FlowFile[]

  @@unique([tenantId, phoneNumber])
}

model Conversation {
  id                 String              @id @default(cuid())
  tenantId           String
  customerId         String
  channel            ConversationChannel @default(WHATSAPP)
  channelPhoneNumber String
  status             ConversationStatus  @default(OPEN)
  mode               ConversationMode    @default(BOT)
  activeFlowRunId    String?             @unique
  assignedAdminId    String?
  handoffReason      String?
  botResumeAt        DateTime?
  chatClearedAt      DateTime?
  lastMessageAt      DateTime            @default(now())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages           Message[]
  messageReactions   MessageReaction[]
  assignedAdmin      TenantAdmin?        @relation(fields: [assignedAdminId], references: [id], onDelete: SetNull)
  activeFlowRun      FlowRun?            @relation("ConversationActiveFlowRun", fields: [activeFlowRunId], references: [id], onDelete: SetNull)
  flowRuns           FlowRun[]           @relation("ConversationFlowRuns")
  flowFiles          FlowFile[]
  usageEvents        UsageEvent[]

  @@index([tenantId, lastMessageAt(sort: Desc)])
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  tenantId          String
  customerId        String?
  direction         MessageDirection @default(INBOUND)
  senderType        SenderType
  senderPhone       String
  receiverPhone     String
  contentText       String
  contentType         ContentType      @default(TEXT)
  contentTextSnapshot String?
  customerEditedAt    DateTime?
  customerRevokedAt   DateTime?
  externalId              String?
  whatsappDeliveryStatus  WhatsappDeliveryStatus?
  aiGenerated       Boolean          @default(false)
  replyToMessageId  String?
  quotedText        String?
  quotedSenderType  SenderType?
  replyToExternalId String?
  rawPayloadJson    Json?
  mediaStorageBucket String?
  mediaStoragePath   String?
  mediaMimeType      String?
  mediaFilename      String?
  mediaFileSize      Int?
  whatsappMediaId    String?
  createdAt         DateTime         @default(now())
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  replyTo           Message?         @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies           Message[]        @relation("MessageReplies")
  reactions         MessageReaction[]

  @@index([replyToMessageId])
  @@index([externalId])
  @@index([conversationId, createdAt])
  @@index([tenantId, direction, senderType, createdAt])
}

model MessageReaction {
  id             String     @id @default(cuid())
  tenantId       String
  conversationId String
  messageId      String
  emoji          String
  senderType     SenderType
  senderPhone    String?
  externalId     String?    @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, senderPhone])
  @@index([messageId])
  @@index([conversationId])
}

model UsageEvent {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String?
  eventType      String
  tokensInput    Int?
  tokensOutput   Int?
  estimatedCost  Float?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId, eventType])
  @@index([tenantId, createdAt])
}

model TenantCatalogProduct {
  id          String               @id @default(cuid())
  tenantId    String
  externalId  String?
  sku         String?
  name        String
  description String?
  price       Float?
  currency    String               @default("CLP")
  category    String?
  tags        Json                 @default("[]")
  metadata    Json                 @default("{}")
  source      CatalogProductSource @default(MANUAL)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@unique([tenantId, externalId])
}

model TenantDeliveryRegion {
  id           String                 @id @default(cuid())
  tenantId     String
  name         String
  courier      String
  defaultPrice Int
  isActive     Boolean                @default(true)
  sortOrder    Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  communes     TenantDeliveryCommune[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model TenantDeliveryCommune {
  id            String               @id @default(cuid())
  regionId      String
  name          String
  priceOverride Int?
  isActive      Boolean              @default(true)
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  region        TenantDeliveryRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([regionId, name])
  @@index([regionId, isActive])
}

model TenantIntegration {
  id                   String              @id @default(cuid())
  tenantId             String
  provider             IntegrationProvider
  shopDomain           String?
  credentialsEncrypted String?
  configJson           Json                @default("{}")
  lastSyncAt           DateTime?
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorType   String
  actorRef    String?
  eventType   String
  payloadJson Json     @default("{}")
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ChatImportJob {
  id                    String              @id @default(cuid())
  tenantId              String
  uploadedBy            String?
  originalFilename      String
  fileUrl               String
  storagePath           String?
  businessSenderName    String?
  status                ChatImportJobStatus @default(PENDING)
  totalMessages         Int                 @default(0)
  customerMessagesCount Int                 @default(0)
  businessMessagesCount Int                 @default(0)
  detectedFaqCount      Int                 @default(0)
  detectedToneSummary   String?
  errorMessage          String?
  metadata              Json                @default("{}")
  createdAt             DateTime            @default(now())
  startedAt             DateTime?
  completedAt           DateTime?
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages              ImportedChatMessage[]
  faqSuggestions        DetectedFaqSuggestion[]
  toneAnalysis          ToneAnalysisResult[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model ImportedChatMessage {
  id                 String         @id @default(cuid())
  tenantId           String
  importJobId        String
  messageAt          DateTime?
  senderLabel        String?
  senderRole         ChatSenderRole @default(UNKNOWN)
  content            String?
  contentAnonymized  String?
  isQuestion         Boolean        @default(false)
  isBusinessResponse Boolean        @default(false)
  detectedIntent     String?
  metadata           Json           @default("{}")
  createdAt          DateTime       @default(now())
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  importJob          ChatImportJob  @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@index([tenantId, senderRole])
}

model DetectedFaqSuggestion {
  id                 String              @id @default(cuid())
  tenantId           String
  importJobId        String?
  question           String
  normalizedQuestion String?
  suggestedAnswer    String?
  category           String?
  evidenceCount      Int                 @default(1)
  confidence         Float?
  status             FaqSuggestionStatus @default(PENDING_REVIEW)
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  importJob          ChatImportJob?      @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model ToneAnalysisResult {
  id                  String             @id @default(cuid())
  tenantId            String
  importJobId         String?
  toneSummary         String
  communicationStyle  String?
  commonPhrases       Json               @default("[]")
  emojiUsage          String?
  responseLength      String?
  salesStyle          String?
  formalityLevel      String?
  recommendedBotRules Json               @default("{}")
  confidence          Float?
  status              ToneAnalysisStatus @default(PENDING_REVIEW)
  reviewedBy          String?
  reviewedAt          DateTime?
  createdAt           DateTime           @default(now())
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  importJob           ChatImportJob?     @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model FlowDefinition {
  id               String               @id @default(cuid())
  tenantId         String
  name             String
  description      String?
  status           FlowDefinitionStatus @default(DRAFT)
  currentVersionId String?              @unique
  createdByAdminId String
  updatedByAdminId String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByAdmin   TenantAdmin          @relation("FlowDefinitionCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  updatedByAdmin   TenantAdmin?         @relation("FlowDefinitionUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)
  currentVersion   FlowVersion?         @relation("FlowDefinitionCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         FlowVersion[]        @relation("FlowDefinitionVersions")

  @@index([tenantId, status])
  @@index([tenantId, updatedAt(sort: Desc)])
}

model FlowVersion {
  id               String            @id @default(cuid())
  tenantId         String
  flowDefinitionId String
  versionNumber    Int
  graphJson        Json
  status           FlowVersionStatus @default(DRAFT)
  publishedAt      DateTime?
  createdByAdminId String
  createdAt        DateTime          @default(now())
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flowDefinition   FlowDefinition    @relation("FlowDefinitionVersions", fields: [flowDefinitionId], references: [id], onDelete: Cascade)
  createdByAdmin   TenantAdmin       @relation("FlowVersionCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  asCurrentFor     FlowDefinition?   @relation("FlowDefinitionCurrentVersion")
  triggers         FlowTrigger[]
  runs             FlowRun[]

  @@unique([flowDefinitionId, versionNumber])
  @@index([tenantId, status])
}

model FlowTrigger {
  id                String               @id @default(cuid())
  tenantId          String
  flowVersionId     String
  triggerType       FlowTriggerType
  channel           ConversationChannel?
  priority          Int                  @default(100)
  configurationJson Json                 @default("{}")
  webhookSecretHash String?
  isEnabled         Boolean              @default(true)
  createdAt         DateTime             @default(now())
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flowVersion       FlowVersion          @relation(fields: [flowVersionId], references: [id], onDelete: Cascade)

  @@index([tenantId, triggerType, isEnabled])
  @@index([flowVersionId])
}

model FlowRun {
  id                    String        @id @default(cuid())
  tenantId              String
  flowVersionId         String
  conversationId        String
  customerId            String
  currentNodeId         String?
  status                FlowRunStatus @default(RUNNING)
  variablesJson         Json          @default("{}")
  pendingAgentInputJson Json?
  startedBy             FlowStartedBy
  startedByAdminId      String?
  lockVersion           Int           @default(0)
  startedAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  completedAt           DateTime?
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flowVersion           FlowVersion   @relation(fields: [flowVersionId], references: [id], onDelete: Restrict)
  conversation          Conversation  @relation("ConversationFlowRuns", fields: [conversationId], references: [id], onDelete: Cascade)
  customer              Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  startedByAdmin        TenantAdmin?  @relation("FlowRunStartedByAdmin", fields: [startedByAdminId], references: [id], onDelete: SetNull)
  activeForConversation Conversation? @relation("ConversationActiveFlowRun")
  events                FlowRunEvent[]
  reviews               FlowReview[]
  tasks                 FlowTask[]
  files                 FlowFile[]
  webhookDeliveries     FlowWebhookDelivery[]

  @@index([tenantId, status])
  @@index([conversationId, status])
  @@index([flowVersionId])
}

model FlowRunEvent {
  id                String   @id @default(cuid())
  tenantId          String
  flowRunId         String
  nodeId            String?
  eventType         String
  payloadJson       Json     @default("{}")
  platformMessageId String?
  idempotencyKey    String?  @unique
  createdAt         DateTime @default(now())
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flowRun           FlowRun  @relation(fields: [flowRunId], references: [id], onDelete: Cascade)

  @@index([flowRunId, createdAt])
  @@index([tenantId, eventType])
  webhookDeliveries FlowWebhookDelivery[]
}

model FlowReview {
  id               String           @id @default(cuid())
  tenantId         String
  flowRunId        String
  nodeId           String
  reviewerAdminId  String?
  subjectType      String
  subjectReference String?
  status           FlowReviewStatus @default(PENDING)
  resolution       String?
  notes            String?
  attempt          Int              @default(1)
  createdAt        DateTime         @default(now())
  resolvedAt       DateTime?
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flowRun          FlowRun          @relation(fields: [flowRunId], references: [id], onDelete: Cascade)
  reviewerAdmin    TenantAdmin?     @relation("FlowReviewReviewer", fields: [reviewerAdminId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([flowRunId, status])
}

model FlowTask {
  id           String         @id @default(cuid())
  tenantId     String
  flowRunId    String
  nodeId       String
  taskType     String
  status       FlowTaskStatus @default(PENDING)
  dueAt        DateTime?
  attemptCount Int            @default(0)
  payloadJson  Json           @default("{}")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flowRun      FlowRun        @relation(fields: [flowRunId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([flowRunId, status])
}

model FlowFile {
  id               String         @id @default(cuid())
  tenantId         String
  flowRunId        String?
  conversationId   String?
  customerId       String?
  storageBucket    String
  storagePath      String
  mimeType         String?
  fileSize         Int?
  originalFilename String?
  source           FlowFileSource
  createdAt        DateTime       @default(now())
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flowRun          FlowRun?       @relation(fields: [flowRunId], references: [id], onDelete: SetNull)
  conversation     Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customer         Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId, flowRunId])
  @@index([conversationId])
  @@unique([storageBucket, storagePath])
}

model FlowWebhookDelivery {
  id              String                    @id @default(cuid())
  tenantId        String
  flowRunId       String
  flowRunEventId  String?
  nodeId          String?
  eventType       String
  targetUrl       String
  payloadJson     Json
  status          FlowWebhookDeliveryStatus @default(PENDING)
  attemptCount    Int                       @default(0)
  maxAttempts     Int                       @default(5)
  lastHttpStatus  Int?
  lastError       String?
  lastAttemptAt   DateTime?
  deliveredAt     DateTime?
  nextRetryAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flowRun         FlowRun                   @relation(fields: [flowRunId], references: [id], onDelete: Cascade)
  flowRunEvent    FlowRunEvent?             @relation(fields: [flowRunEventId], references: [id], onDelete: SetNull)
  attempts        FlowWebhookDeliveryAttempt[]

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([flowRunId, createdAt(sort: Desc)])
  @@index([flowRunEventId])
}

model FlowWebhookDeliveryAttempt {
  id               String              @id @default(cuid())
  deliveryId       String
  attemptNumber    Int
  httpStatus       Int?
  responseBody     String?
  errorMessage     String?
  durationMs       Int?
  createdAt        DateTime            @default(now())
  delivery         FlowWebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, attemptNumber])
}
