{
  "name": "chat-whatsapp-ai-saas-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:api": "tsx watch src/api.ts",
    "dev:workers": "tsx watch src/workers.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:prod": "prisma migrate deploy && node dist/server.js",
    "start:api": "node dist/api.js",
    "start:workers": "node dist/workers.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:index-knowledge": "tsx prisma/index-knowledge.ts",
    "activate:twd": "tsx scripts/activate-twd-whatsapp.ts",
    "seed:knowledge": "tsx scripts/seed-knowledge-fixtures.ts",
    "refresh:knowledge": "tsx scripts/refresh-knowledge-content.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "prisma": "^5.20.0",
    "adm-zip": "^0.5.17",
    "bullmq": "^5.78.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "ioredis": "^5.11.1",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "openai": "^4.67.1",
    "pdf-parse": "^2.4.5",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.7.4",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.4"
  }
}
