{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UpdateStagingEcsService",
      "Effect": "Allow",
      "Action": ["ecs:UpdateService", "ecs:DescribeServices"],
      "Resource": "arn:aws:ecs:sa-east-1:024848463506:service/easycomp-staging/chat-whatsapp-ai-combined"
    },
    {
      "Sid": "LambdaLogs",
      "Effect": "Allow",
