{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcsNightlyStopLambda",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:DeleteFunction",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:sa-east-1:024848463506:function:easycomp-staging-ecs-nightly-stop"
    },
    {
      "Sid": "EcsNightlyStopScheduler",
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateSchedule",
        "scheduler:UpdateSchedule",
        "scheduler:GetSchedule",
        "scheduler:DeleteSchedule"
      ],
      "Resource": "arn:aws:scheduler:sa-east-1:024848463506:schedule/default/easycomp-staging-ecs-stop-2359"
    },
    {
      "Sid": "EcsNightlyStopSchedulerRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:PutRolePolicy",
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::024848463506:role/easycomp-staging-ecs-scheduler-lambda",
        "arn:aws:iam::024848463506:role/easycomp-staging-eventbridge-scheduler"
      ]
    }
  ]
}
