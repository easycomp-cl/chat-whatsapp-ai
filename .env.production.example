# =============================================================================
# EasyComp Bot IA — variables de PRODUCCIÓN / STAGING en cloud (AWS)
# =============================================================================
# Copia este archivo a .env.production y reemplaza los valores.
# NO commitees .env.production (está en .gitignore).
#
# En AWS estos mismos valores van en Secrets Manager (chat-whatsapp-ai/staging
# o chat-whatsapp-ai/production), no como archivo en el contenedor.
#
# Dominios del proyecto:
#   UI:      https://conversai.easycomp.cl          (Vercel)
#   API:     https://api.conversai.easycomp.cl      (AWS ECS + ALB)
#   Webhook: https://api.conversai.easycomp.cl/webhooks/whatsapp
# =============================================================================

NODE_ENV=production
PORT=3000

# Supabase → Settings → Database → Connection string
# En AWS/ECS usa el POOLER (IPv4, puerto 6543), NO el directo :5432
# Transaction mode o Session mode pooler. Ejemplo Session:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Si Prisma da errores de prepared statements, agrega: ?pgbouncer=true
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Upstash Redis → TLS URL (debe empezar con rediss://)
# Plan Free: 500k comandos/mes POR BASE DE DATOS. BullMQ en ECS 24/7 lo agota rapido.
# Dev local: usa redis://localhost:6379 (.env), NO esta URL.
# Staging: apaga ECS con scripts/aws-staging-stop.ps1 cuando no desarrolles.
REDIS_URL=rediss://default:[PASSWORD]@[HOST].upstash.io:6379

# Inventa un token largo; debe ser IDÉNTICO al que pongas en Meta Developer
WHATSAPP_VERIFY_TOKEN=replace_with_long_random_token

WHATSAPP_GRAPH_VERSION=v20.0

# Meta Developer → App → Settings → Basic → App Secret
META_APP_SECRET=replace_with_meta_app_secret

# Meta Business / System User token (opcional si cada tenant tiene su token en BD)
META_SYSTEM_USER_ACCESS_TOKEN=replace_with_meta_system_user_token

OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Mínimo 32 caracteres. NO cambiar después de guardar tokens WhatsApp cifrados.
ENCRYPTION_SECRET=replace_with_at_least_32_random_characters

# Debe ser IGUAL a BOT_API_SECRET en Vercel (mismo ambiente)
INTERNAL_API_KEY=replace_with_long_random_internal_api_key

FAQ_SIMILARITY_THRESHOLD=0.80

# En Docker/ECS usar ruta absoluta (disco efímero en Fargate; migrar a Supabase Storage después)
STORAGE_PATH=/app/storage

SHOPIFY_API_VERSION=2024-10

# SIEMPRE false en cloud (Meta valida firma del webhook)
SKIP_WEBHOOK_SIGNATURE=false

DEFAULT_TIMEZONE=America/Santiago

# Supabase Storage (media de chat + archivos de flujos)
# Obligatorio en ECS: sin estas variables los adjuntos se guardan en disco efímero y se pierden al reiniciar.
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_FLOW_FILES_BUCKET=flow-files
SUPABASE_CHAT_MEDIA_BUCKET=chat-media
